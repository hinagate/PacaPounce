# ── LLM (Poe, OpenAI-compatible) ─────────────────────────────────────────────
POE_KEY=your_poe_api_key
POE_MODEL=gemini-3.7-flash
PACAPOUNCE_LLM_MAX_TOKENS=4000

# ── Alpaca PAPER keys ────────────────────────────────────────────────────────
# Generate these in the Alpaca dashboard with the Paper toggle ON.
# Paper keys are SEPARATE from live keys. Live keys 401 against paper-api.
ALPACA_PAPER_KEY=your_paper_key
ALPACA_PAPER_SECRET=your_paper_secret
# Required fail-closed identity boundary for the judged paper account.
ALPACA_ACCOUNT_ID=your_submission_account_id

# 'indicative' is the free derived feed (approximations, 15-min delayed trades).
# 'opra' is real NBBO and requires Algo Trader Plus.
PACAPOUNCE_OPTIONS_FEED=indicative

# ── Universe and structure ───────────────────────────────────────────────────
PACAPOUNCE_ALLOWLIST=SPY,QQQ
PACAPOUNCE_DTE_MIN=1
PACAPOUNCE_DTE_MAX=7
PACAPOUNCE_SIZING_MODE=full_buying_power
PACAPOUNCE_OPTIONS_BP_UTILIZATION=1.0
PACAPOUNCE_MIN_OPTIONS_TRADING_LEVEL=3
PACAPOUNCE_MAX_CONTRACTS=1000
PACAPOUNCE_MAX_OPEN=3
PACAPOUNCE_MAX_TRADES_PER_DAY=4
# Used only when PACAPOUNCE_SIZING_MODE=kelly.
PACAPOUNCE_MAX_EQUITY_AT_RISK=0.02
PACAPOUNCE_ANNUAL_RETURN_TARGET=0.08
PACAPOUNCE_TRADING_DAYS_PER_YEAR=252

# ── Gate thresholds ──────────────────────────────────────────────────────────
PACAPOUNCE_MAX_LOSS_USD=500
# Used only when PACAPOUNCE_SIZING_MODE=kelly. Full-buying-power mode uses Alpaca's
# live options_buying_power as its total defined-loss cap.
PACAPOUNCE_MAX_TOTAL_RISK_USD=4000
PACAPOUNCE_MAX_LEG_SPREAD_PCT=0.25
PACAPOUNCE_QUOTE_MAX_AGE_SEC=120
PACAPOUNCE_MIN_EV_USD=0
# Call spreads are vetoed after a one-day index selloff below this return because
# the positive-drift right tail is exposed to a short-horizon rebound.
PACAPOUNCE_CALL_REBOUND_MIN_1D_RETURN=-0.01
# One initial proposal plus at most one reasoned, materially different revision.
PACAPOUNCE_PROPOSAL_BUDGET=2
PACAPOUNCE_SESSION_POLL_INTERVAL_SEC=60
# MCP-derived 1D/5D return, RV20, ATM IV and IV/RV feature cache.
PACAPOUNCE_REGIME_CACHE_SEC=300
# Static dashboard data rebuild + browser reload cadence while run.py --loop runs.
PACAPOUNCE_DASHBOARD_REFRESH_INTERVAL_SEC=60

# Paper-session monitor.  Auto-exits are disabled unless monitor.py is started
# with --execute.
PACAPOUNCE_MONITOR_INTERVAL_SEC=30
# Opening credit orders improve by at most one cent per monitor cycle and never
# cross below the live natural (short bid - long ask) spread price.
PACAPOUNCE_CHASE_STEP=0.01
PACAPOUNCE_MONITOR_PROFIT_TARGET_PCT=0.50
PACAPOUNCE_MONITOR_STOP_MAX_LOSS_PCT=0.70
PACAPOUNCE_MONITOR_PIN_BUFFER_USD=1.00
PACAPOUNCE_MONITOR_LIMIT_SLIPPAGE=0.02
PACAPOUNCE_MONITOR_RATCHET_ARM_PCT=0.20
PACAPOUNCE_MONITOR_RATCHET_GIVEBACK_PCT=0.20
PACAPOUNCE_MONITOR_HIGH_VOL_RATCHET_GIVEBACK_PCT=0.10
PACAPOUNCE_MONITOR_RATCHET_CONFIRMATIONS=2
PACAPOUNCE_MONITOR_VOL_WINDOW_SAMPLES=10
PACAPOUNCE_MONITOR_HIGH_VOL_PCT_MAX_PROFIT=0.03

# A profitable close earns at most one new attempt after both time and market
# volatility reset. Tournament re-entry uses the full available options BP and
# must beat the previous post-cost EV/risk quality by at least 25%.
PACAPOUNCE_REENTRY_COOLDOWN_MIN=15
PACAPOUNCE_REENTRY_STABLE_MIN=10
PACAPOUNCE_REENTRY_MIN_QUALITY_MULTIPLIER=1.0
PACAPOUNCE_REENTRY_MAX_PER_DAY=3
PACAPOUNCE_REENTRY_BP_UTILIZATION=1.0

# ── Second options strategy: NDX30 long-call mean reversion ─────────────────
# One normal-session scan at 15:45 ET; every competition order is an option.
PACAPOUNCE_OPTION_MR_ENABLED=true
PACAPOUNCE_OPTION_MR_UNIVERSE=AAPL,MSFT,AMZN,GOOGL,GOOG,NVDA,TSLA,META,PEP,AVGO,COST,CSCO,TMUS,ADBE,TXN,CMCSA,AMD,HON,AMGN,QCOM,NFLX,INTU,SBUX,GILD,ADP,BKNG,ISRG,MDLZ,PYPL,INTC
# Target 0.5%; because options are indivisible, one contract may use at most 2%.
PACAPOUNCE_OPTION_MR_EQUITY_RISK_PCT=0.005
PACAPOUNCE_OPTION_MR_ONE_CONTRACT_RISK_CAP_PCT=0.02
PACAPOUNCE_OPTION_MR_STOP_ATR_MULTIPLE=2.0
PACAPOUNCE_OPTION_MR_DTE_MIN=14
PACAPOUNCE_OPTION_MR_DTE_MAX=30
PACAPOUNCE_OPTION_MR_DELTA_TARGET=0.70
PACAPOUNCE_OPTION_MR_DELTA_MIN=0.55
PACAPOUNCE_OPTION_MR_DELTA_MAX=0.85
PACAPOUNCE_OPTION_MR_MAX_SPREAD_PCT=0.06
# Mean underlying move per signal trade, measured on the frozen 2026 YTD scan
# (108 trades). A call whose crossing cost plus holding-period theta needs more
# than this cannot be paid for by the signal, and is rejected before entry.
PACAPOUNCE_OPTION_MR_SIGNAL_EDGE_PCT=0.00795
PACAPOUNCE_OPTION_MR_MAX_POSITIONS=4
PACAPOUNCE_OPTION_MR_MAX_ENTRIES_PER_DAY=2
PACAPOUNCE_OPTION_MR_MAX_HOLD_SESSIONS=5
PACAPOUNCE_OPTION_MR_DECISION_MINUTE=45

# ── Two-lane capital budget ─────────────────────────────────────────────────
# Each lane owns a share of EQUITY, bounded by live options buying power. Taking
# the share from equity rather than from remaining BP keeps a lane's allocation
# independent of which lane happened to fill first.
#
# The competition values below implement a deliberate objective change from
# maximizing expected value to maximizing the UPPER TAIL: a four-session P&L
# leaderboard rewards the tail, and a credit spread (win ~6%, lose ~94%) cannot
# produce a placing number no matter how large it is sized. Long calls are the
# only structure here with upside convexity. This is disclosed in the README,
# and it is NOT a claim that the long-call lane has positive expected value -
# the measured evidence says it does not. For an expected-value configuration,
# set SPREAD_EQUITY_PCT=0.95 and OPTION_MR_SIZING_MODE=risk_budget.
PACAPOUNCE_SPREAD_EQUITY_PCT=0.20
PACAPOUNCE_OPTION_MR_SIZING_MODE=tournament
PACAPOUNCE_OPTION_MR_TOTAL_PREMIUM_PCT=0.70
# Per position. 35% because the 6% spread gate leaves only 2-3 liquid names in a
# window: at 20% the lane could deploy at most 40-60% of its budget.
PACAPOUNCE_OPTION_MR_MAX_PREMIUM_PCT=0.35
# RSI(2)<10 yields ~2-3 signals in four sessions, too few to deploy 70%. Widening
# keeps the rising-SMA200 trend filter and the AI event review on every entry.
PACAPOUNCE_OPTION_MR_RSI_MAX=25
# How many times the measured signal edge a contract's carry may cost. 1.0 is
# the expected-value reading; the tournament loosens it so the gate's job narrows
# to rejecting the genuinely unpayable. Selection still takes the cheapest carry.
PACAPOUNCE_OPTION_MR_CARRY_EDGE_MULTIPLE=3.0
