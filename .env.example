# ── LLM (Poe, OpenAI-compatible) ─────────────────────────────────────────────
POE_KEY=your_poe_api_key
POE_MODEL=gemini-3.7-flash
PACAPOUNCE_LLM_MAX_TOKENS=4000

# ── Alpaca PAPER keys ────────────────────────────────────────────────────────
# Generate these in the Alpaca dashboard with the Paper toggle ON.
# Paper keys are SEPARATE from live keys. Live keys 401 against paper-api.
ALPACA_PAPER_KEY=your_paper_key
ALPACA_PAPER_SECRET=your_paper_secret
# Required fail-closed identity boundary for the judged paper account.
ALPACA_ACCOUNT_ID=your_submission_account_id

# 'indicative' is the free derived feed (approximations, 15-min delayed trades).
# 'opra' is real NBBO and requires Algo Trader Plus.
PACAPOUNCE_OPTIONS_FEED=indicative

# ── Universe and structure ───────────────────────────────────────────────────
PACAPOUNCE_ALLOWLIST=SPY,QQQ
PACAPOUNCE_DTE_MIN=1
PACAPOUNCE_DTE_MAX=7
PACAPOUNCE_SIZING_MODE=full_buying_power
PACAPOUNCE_OPTIONS_BP_UTILIZATION=1.0
PACAPOUNCE_MIN_OPTIONS_TRADING_LEVEL=3
PACAPOUNCE_MAX_CONTRACTS=1000
PACAPOUNCE_MAX_OPEN=3
PACAPOUNCE_MAX_TRADES_PER_DAY=2
# Used only when PACAPOUNCE_SIZING_MODE=kelly.
PACAPOUNCE_MAX_EQUITY_AT_RISK=0.02
PACAPOUNCE_ANNUAL_RETURN_TARGET=0.08
PACAPOUNCE_TRADING_DAYS_PER_YEAR=252

# ── Gate thresholds ──────────────────────────────────────────────────────────
PACAPOUNCE_MAX_LOSS_USD=500
# Used only when PACAPOUNCE_SIZING_MODE=kelly. Full-buying-power mode uses Alpaca's
# live options_buying_power as its total defined-loss cap.
PACAPOUNCE_MAX_TOTAL_RISK_USD=4000
PACAPOUNCE_MAX_LEG_SPREAD_PCT=0.25
PACAPOUNCE_QUOTE_MAX_AGE_SEC=120
PACAPOUNCE_MIN_EV_USD=0
# Call spreads are vetoed after a one-day index selloff below this return because
# the positive-drift right tail is exposed to a short-horizon rebound.
PACAPOUNCE_CALL_REBOUND_MIN_1D_RETURN=-0.01
# One initial proposal plus at most one reasoned, materially different revision.
PACAPOUNCE_PROPOSAL_BUDGET=2
PACAPOUNCE_SESSION_POLL_INTERVAL_SEC=60
# MCP-derived 1D/5D return, RV20, ATM IV and IV/RV feature cache.
PACAPOUNCE_REGIME_CACHE_SEC=300
# Static dashboard data rebuild + browser reload cadence while run.py --loop runs.
PACAPOUNCE_DASHBOARD_REFRESH_INTERVAL_SEC=60

# Paper-session monitor.  Auto-exits are disabled unless monitor.py is started
# with --execute.
PACAPOUNCE_MONITOR_INTERVAL_SEC=30
# Opening credit orders improve by at most one cent per monitor cycle and never
# cross below the live natural (short bid - long ask) spread price.
PACAPOUNCE_CHASE_STEP=0.01
PACAPOUNCE_MONITOR_PROFIT_TARGET_PCT=0.50
PACAPOUNCE_MONITOR_STOP_MAX_LOSS_PCT=0.70
PACAPOUNCE_MONITOR_PIN_BUFFER_USD=1.00
PACAPOUNCE_MONITOR_LIMIT_SLIPPAGE=0.02
PACAPOUNCE_MONITOR_RATCHET_ARM_PCT=0.20
PACAPOUNCE_MONITOR_RATCHET_GIVEBACK_PCT=0.20
PACAPOUNCE_MONITOR_HIGH_VOL_RATCHET_GIVEBACK_PCT=0.10
PACAPOUNCE_MONITOR_RATCHET_CONFIRMATIONS=2
PACAPOUNCE_MONITOR_VOL_WINDOW_SAMPLES=10
PACAPOUNCE_MONITOR_HIGH_VOL_PCT_MAX_PROFIT=0.03

# A profitable close earns at most one new attempt after both time and market
# volatility reset. Tournament re-entry uses the full available options BP and
# must beat the previous post-cost EV/risk quality by at least 25%.
PACAPOUNCE_REENTRY_COOLDOWN_MIN=30
PACAPOUNCE_REENTRY_STABLE_MIN=10
PACAPOUNCE_REENTRY_MIN_QUALITY_MULTIPLIER=1.25
PACAPOUNCE_REENTRY_BP_UTILIZATION=1.0

# ── Second Paper strategy: NDX30 mean reversion ─────────────────────────────
# Frozen Paper-Staging policy. One normal-session scan at 15:45 ET; at most one
# new stock position/day. The defaults below reproduce the tested policy.
PACAPOUNCE_STOCK_MR_ENABLED=true
PACAPOUNCE_STOCK_MR_UNIVERSE=AAPL,MSFT,AMZN,GOOGL,GOOG,NVDA,TSLA,META,PEP,AVGO,COST,CSCO,TMUS,ADBE,TXN,CMCSA,AMD,HON,AMGN,QCOM,NFLX,INTU,SBUX,GILD,ADP,BKNG,ISRG,MDLZ,PYPL,INTC
PACAPOUNCE_STOCK_MR_RSI_MAX=10
PACAPOUNCE_STOCK_MR_EQUITY_RISK_PCT=0.005
PACAPOUNCE_STOCK_MR_MAX_NOTIONAL_PCT=0.20
PACAPOUNCE_STOCK_MR_STOP_ATR_MULTIPLE=2.0
PACAPOUNCE_STOCK_MR_MAX_POSITIONS=3
PACAPOUNCE_STOCK_MR_MAX_ENTRIES_PER_DAY=1
PACAPOUNCE_STOCK_MR_MAX_HOLD_SESSIONS=3
PACAPOUNCE_STOCK_MR_DECISION_MINUTE=45
